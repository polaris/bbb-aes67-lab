software =
{
    version = "@@BBB_VERSION@@";
    description = "Update";
    hardware-compatibility: [ "@@HW_REVISION@@" ];

    stable:
    {
        root_a:
        {
            images: (
                {
                    filename = "bbb-image-@@MACHINE@@.rootfs.ext4.gz";
                    device = "/dev/mmcblk0p2";
                    type = "raw";
                    compressed = "zlib";
                }
            );

            bootenv: (
                {
                    name = "rootpart";
                    value = "2";
                }
            );
        };
        root_b:
        {
            images: (
                {
                    filename = "bbb-image-@@MACHINE@@.rootfs.ext4.gz";
                    device = "/dev/mmcblk0p3";
                    type = "raw";
                    compressed = "zlib";
                }
            );

            bootenv: (
                {
                    name = "rootpart";
                    value = "3";
                }
            );
        };

    };
};
